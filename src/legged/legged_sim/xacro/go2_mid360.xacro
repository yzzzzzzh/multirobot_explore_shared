<?xml version="1.0"?>
<!-- Unitree Go2 + Mid-360-style LiDAR for the two-robot RACER exploration stack.
     Derived from go2_description/xacro/robot.xacro (quadruped_ros2_control, humble branch)
     with per-robot namespace, Gazebo Fortress plugin names and a gpu_lidar on the trunk. -->
<robot name="go2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="robot_namespace" default="bot1"/>
  <xacro:arg name="controllers_yaml" default="/tmp/go2_controllers.yaml"/>
  <xacro:arg name="lidar_x" default="0.0"/>
  <xacro:arg name="lidar_z" default="0.095"/>
  <xacro:property name="ns" value="$(arg robot_namespace)"/>

  <xacro:include filename="$(find go2_description)/xacro/const.xacro"/>
  <xacro:include filename="$(find go2_description)/xacro/materials.xacro"/>
  <xacro:include filename="$(find go2_description)/xacro/leg.xacro"/>
  <xacro:include filename="$(find legged_sim)/xacro/go2_gz_ns.xacro"/>

  <link name="base">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <joint name="floating_base" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base"/>
    <child link="trunk"/>
  </joint>

  <link name="trunk">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find go2_description)/meshes/trunk.dae" scale="1 1 1"/>
      </geometry>
      <!-- <material name="orange"/> -->
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="${trunk_length} ${trunk_width} ${trunk_height}"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.1881 0.04675 0.057"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0.285 0 0.01"/>
      <geometry>
        <cylinder length="0.05" radius="0.045"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0.293 0 -0.06"/>
      <geometry>
        <box size="0.047 0.047 0.047"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="${trunk_com_x} ${trunk_com_y} ${trunk_com_z}"/>
      <mass value="${trunk_mass}"/>
      <inertia
          ixx="${trunk_ixx}" ixy="${trunk_ixy}" ixz="${trunk_ixz}"
          iyy="${trunk_iyy}" iyz="${trunk_iyz}"
          izz="${trunk_izz}"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="trunk"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <!-- <material name="red"/> -->
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size=".001 .001 .001"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint_front" type="fixed">
    <parent link="trunk"/>
    <child link="front_camera"/>
    <origin rpy="0 0 0" xyz="0.32715 0 0.04297"/>
  </joint>

  <link name="front_camera">
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin
        xyz="0.28945 0 -0.046825" rpy="0 2.8782 0"/>
    <parent link="trunk"/>
    <child link="lidar"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="lidar">
  </link>

  <joint name="lidar_link_joint" type="fixed">
    <parent link="trunk"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="$(arg lidar_x) 0 $(arg lidar_z)"/>
  </joint>
  <link name="lidar_link">
    <inertial>
      <mass value="0.05"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.06"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Passive retro-reflective beacon for Swarm-LIO2 teammate detection
       (same role as retro_beacon_link on the wheeled quadruped_mid360 proxy:
       one compact high-intensity cluster on the body yaw axis).  The Go2's
       LiDAR sits only 0.095 m above the trunk, so the beacon is a mast ABOVE
       the sensor: bottom face 0.16 m over the sensor origin at radius 0.10 m,
       i.e. beyond the +52 deg upper FOV edge (0.10*tan(52deg)=0.128 m), so the
       robot's own scan never hits it, while a teammate's LiDAR (~0.4 m above
       the floor) sees a 0.60 m tall, 0.20 m wide reflector at 0.56-1.16 m
       height (at 8 m: ~1.4 azimuth columns x ~4.6 rows = 5-7 returns per scan,
       ~3 after Swarm-LIO2's point_filter_num 2; a thinner 0.10 x 0.40 mast gave
       only 0-2 returns and never formed a >=2-point cluster).  laser_retro 5000
       > Swarm-LIO2 inten_threshold 1000. -->
  <link name="retro_beacon_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><cylinder radius="0.10" length="0.60"/></geometry>
      <material name="beacon"><color rgba="1.0 0.45 0.02 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="retro_beacon_joint" type="fixed">
    <parent link="trunk"/>
    <child link="retro_beacon_link"/>
    <origin rpy="0 0 0" xyz="$(arg lidar_x) 0 ${float('$(arg lidar_z)') + 0.16 + 0.30}"/>
  </joint>
  <gazebo reference="retro_beacon_link">
    <visual><laser_retro>5000</laser_retro></visual>
  </gazebo>
  <gazebo reference="retro_beacon_joint">
    <disableFixedJointLumping>true</disableFixedJointLumping>
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <xacro:leg name="FR" mirror="-1" mirror_dae="False" front_hind="1" front_hind_dae="True"/>
  <xacro:leg name="FL" mirror="1" mirror_dae="True" front_hind="1" front_hind_dae="True"/>
  <xacro:leg name="RR" mirror="-1" mirror_dae="False" front_hind="-1" front_hind_dae="False"/>
  <xacro:leg name="RL" mirror="1" mirror_dae="True" front_hind="-1" front_hind_dae="False"/>
</robot>
